# Copy this file to ".env" and fill in real values before running the server.
# Never commit the real ".env" file to git.

PORT=4000

# Any long random string — used to sign login sessions (JWTs).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# --- Moyasar (payment gateway) ---------------------------------------
# Get these from https://dashboard.moyasar.com -> Developers -> API Keys.
# Start with the TEST keys (they look like sk_test_... / pk_test_...) so you
# can run through full payments with Moyasar's test cards before going live.
MOYASAR_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MOYASAR_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: set this once you configure a webhook in the Moyasar dashboard
# (Developers -> Webhooks) pointing at {your-backend-url}/api/payments/webhook
MOYASAR_WEBHOOK_SECRET=

# --- Resend (email receipts) ------------------------------------------
# Get an API key from https://resend.com/api-keys after verifying a
# sending domain (or use their test domain while developing).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Manzili <receipts@yourdomain.com>

# URL where your React frontend runs (used for CORS + Socket.io)
FRONTEND_URL=http://localhost:5173

# Seeded automatically on first run — log in with these, then change the
# password immediately from a real admin-settings screen in production.
ADMIN_DEFAULT_EMAIL=admin@manzili.sa
ADMIN_DEFAULT_PASSWORD=Admin@12345
